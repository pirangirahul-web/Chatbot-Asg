FROM rasa/rasa:3.6.20-full

WORKDIR /app
COPY . /app

USER root

RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir "packaging<22"

USER 1001

EXPOSE 5005 5055

# Train at startup if no model exists, then run the server
CMD ["bash", "-c", "rasa train --force && rasa run --enable-api --cors '*' --debug"]
